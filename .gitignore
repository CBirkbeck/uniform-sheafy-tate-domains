# Built copy of the editable LaTeX draft (release PDFs live under output/)
inputs/draft/main.pdf

# Local audit/style corpora: keep their manifests and provenance, but do not
# publish downloaded papers or reference PDFs in the GitHub repository.
references/pdfs/*.pdf
style-corpus/arxiv/*/
style-corpus/author-hosted/*/
