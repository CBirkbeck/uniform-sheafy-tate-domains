+def lean_commit_attr(rec: dict) -> str:
+    """Return a safe ``commit`` attribute for a Lean declaration record.
+
+    Commit-aware validators need an unambiguous object name.  Refuse short or
+    otherwise malformed hashes here instead of emitting a badge that appears
+    pinned but is actually validated against the working tree.
+    """
+    commit = rec.get("commit")
+    if commit is None:
+        return ""
+    if not isinstance(commit, str) or not _FULL_GIT_COMMIT.fullmatch(commit):
+        decl = rec.get("decl", "<unknown declaration>")
+        raise ValueError(
