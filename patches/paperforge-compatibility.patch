--- /dev/null
+++ b/validators/tests/test_lean_links.py
@@ -0,0 +1,57 @@
+"""Tests for commit-pinned Lean declaration validation."""
+from __future__ import annotations
+
+import subprocess
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from paperforge_validators import lean_links  # noqa: E402
+
+
+def _git(repo: Path, *args: str) -> str:
+    proc = subprocess.run(
+        ["git", "-C", str(repo), *args], check=True,
+        text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+    return proc.stdout.strip()
+
+
+def test_lean_links_checks_exact_commit_and_recognises_classes(tmp_path):
+    repo = tmp_path / "formalization"
+    project = repo / "projects" / "Demo"
+    project.mkdir(parents=True)
+    _git(repo, "init")
+    _git(repo, "config", "user.name", "Paperforge Test")
+    _git(repo, "config", "user.email", "paperforge@example.invalid")
+    source = project / "Defs.lean"
+    source.write_text("namespace Demo\nclass Historical : Prop where\nend Demo\n")
+    _git(repo, "add", ".")
+    _git(repo, "commit", "-m", "historical declaration")
+    historical = _git(repo, "rev-parse", "HEAD")
+
+    source.write_text("namespace Demo\nclass Current : Prop where\nend Demo\n")
+    _git(repo, "add", ".")
+    _git(repo, "commit", "-m", "replace declaration")
+
+    instance = tmp_path / "paper"
+    ptx = instance / "source" / "main.ptx"
+    ptx.parent.mkdir(parents=True)
+    ptx.write_text(
+        f'<pretext><lean project="Demo" commit="{historical}" '
+        'ref="Demo.Historical">Lean</lean></pretext>')
+    config = {
+        "_root": str(instance),
+        "inputs": {
+            "lean_project": str(project),
+            "formalizations": {"Demo": {"root": str(project)}},
+        },
+    }
+    assert lean_links.check(config) == []
+
+    ptx.write_text(
+        '<pretext><lean project="Demo" '
+        'ref="Demo.Historical">Lean</lean></pretext>')
+    findings = lean_links.check(config)
+    assert len(findings) == 1
+    assert findings[0].severity == "error"
+    assert "matches no declaration" in findings[0].message
