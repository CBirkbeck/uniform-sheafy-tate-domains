+    draft.write_text(
+        "\\documentclass{amsart}\n\\title{T}\\author{A}\n"
+        "\\begin{document}\n\\section{One}\\label{sec:one}\n"
+        "See \\href{https://example.test/a\\%20b?x=1\\&y=2}"
+        "{the \\emph{source}} and "
+        "\\url{https://example.test/file\\_name}.\n"
+        "\\end{document}\n")
+    out = tmp_path / "src"
